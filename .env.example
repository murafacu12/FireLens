# Copy to .env (repo root or backend/) and fill in. Never commit .env.

# NASA FIRMS MAP_KEY - free at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it FireLens still shows REAL data (last 7 days, public FIRMS files).
# With it you can load fire history (any dates, SP archive).
FIRELENS_FIRMS_MAP_KEY=

# Region of the public FIRMS files used for the live view (exact FIRMS spelling):
# South_America, Central_America, USA_contiguous_and_Hawaii, Canada, Alaska, Europe,
# Northern_and_Central_Africa, Southern_Africa, Russia_Asia, South_Asia, SouthEast_Asia,
# Australia_NewZealand, Global (large: ~35 MB per satellite for 7 days)
FIRELENS_PUBLIC_REGION=Global

# Hourly refresh of the live view (minutes, 0 = off). FIRMS NRT updates every few hours.
FIRELENS_INGEST_INTERVAL_MINUTES=60

# Synthetic data for offline UI work (uses its own database, firelens-demo.db)
# FIRELENS_DEMO_MODE=true
# FIRELENS_INGEST_SOURCES=["MODIS_NRT","VIIRS_SNPP_NRT","VIIRS_NOAA20_NRT","VIIRS_NOAA21_NRT"]

# Default: sqlite firelens.db (live) / firelens-demo.db (demo). PostgreSQL works unchanged:
# FIRELENS_DATABASE_URL=postgresql+psycopg://user:pass@host/db

# Optional: Copernicus Data Space (Sentinel-2 NDVI) OAuth client
# https://shapps.dataspace.copernicus.eu/dashboard
FIRELENS_COPERNICUS_CLIENT_ID=
FIRELENS_COPERNICUS_CLIENT_SECRET=

# Upgrading a database that holds data (new tables/columns, event rebuilds) needs explicit
# permission for one start. Back up and rehearse first: docs/MIGRATION_V3.md
# FIRELENS_ALLOW_SCHEMA_UPGRADE=true
