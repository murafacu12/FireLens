# Copy to deploy/.env on the server and fill in. Never commit .env.

# Public name of the API. Free option without a domain: <your-VM-IP-with-dashes>.sslip.io,
# e.g. 129-146-12-34.sslip.io for IP 129.146.12.34.
API_DOMAIN=

# Address of the website (Vercel), so browsers may call the API from it. JSON list.
FIRELENS_CORS_ORIGINS=["https://firelens.vercel.app"]

# Key for the data-changing endpoints (ingest, history loading, alert rules).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FIRELENS_ADMIN_TOKEN=

# NASA FIRMS key (history loading). Optional: without it the live map still works.
FIRELENS_FIRMS_MAP_KEY=
FIRELENS_PUBLIC_REGION=Global
FIRELENS_INGEST_INTERVAL_MINUTES=60

# Copernicus Data Space (Sentinel-2/3/5P per-fire report, NDVI). Optional.
FIRELENS_COPERNICUS_CLIENT_ID=
FIRELENS_COPERNICUS_CLIENT_SECRET=

# Only for one start after a release that changes the database (back up first).
# FIRELENS_ALLOW_SCHEMA_UPGRADE=true
