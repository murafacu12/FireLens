# Keep local data, builds and secrets out of the image (the root Dockerfile copies only
# frontend/ and backend/pyproject.toml + backend/app).
**/.git
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/*.egg-info
**/*.db
**/*.db-shm
**/*.db-wal
**/.env
**/.env.local
data
backups
deploy
docs
backend/build
backend/tests
backend/ml
